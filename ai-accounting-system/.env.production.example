# =============================================================================
# AI Accounting System -- Production Environment Variables
# =============================================================================
# Copy this file to .env.production and fill in ALL required values.
#
# QUICK START:
#   cp .env.production.example .env.production
#   # Edit .env.production with your real values
#   python -c "import secrets; print(secrets.token_hex(32))"  # Generate SECRET_KEY
#
# NEVER commit .env.production to version control.
# =============================================================================

# --- Flask / Security ---
FLASK_ENV=production
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_64_CHAR_HEX_STRING
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# MUST differ from SECRET_KEY
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_DIFFERENT_RANDOM_64_CHAR_HEX_STRING
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=CHANGE_ME_GENERATE_FERNET_KEY

# --- MySQL ---
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD
MYSQL_DATABASE=ai_accounting
MYSQL_USER=ai_user
MYSQL_PASSWORD=CHANGE_ME_STRONG_USER_PASSWORD

# Full DATABASE_URL (auto-constructed in docker-compose, or set manually)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql+pymysql://ai_user:CHANGE_ME_STRONG_USER_PASSWORD@mysql:3306/ai_accounting?charset=utf8mb4

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
# Full REDIS_URL
REDIS_URL=redis://:CHANGE_ME_STRONG_REDIS_PASSWORD@redis:6379/0

# --- AI / LLM ---
# DeepSeek API Key — 填入你的 DeepSeek API Key
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

# --- Domain ---
DOMAIN=ledgerai.store

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS=https://ledgerai.store,https://www.ledgerai.store

# --- Frontend URL (for email links) ---
FRONTEND_URL=https://ledgerai.store

# --- Backend URL ---
BACKEND_URL=https://ledgerai.store

# --- Object Storage ---
STORAGE_PROVIDER=local

# --- Logging ---
LOG_LEVEL=INFO

# --- Sentry (Error Tracking) ---
SENTRY_DSN=

# --- Grafana ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_STRONG_GRAFANA_PASSWORD

# --- Rate Limiting ---
RATELIMIT_STORAGE_URI=redis://redis:6379

# --- SMTP Email (REQUIRED for registration verification and password reset) ---
# Common SMTP servers:
#   QQ Mail:   smtp.qq.com:587 (TLS) or smtp.qq.com:465 (SSL)
#   Gmail:     smtp.gmail.com:587 (TLS)
#   163 Mail:  smtp.163.com:465 (SSL)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=AI 智能记账
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# --- Admin ---
# Initial admin password (change after first login!)
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# --- Monitoring ---
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
METRICS_AUTH_TOKEN=CHANGE_ME_GENERATE_METRICS_TOKEN
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
REQUEST_SIGNING_SECRET=CHANGE_ME_GENERATE_SIGNING_SECRET

# --- MySQL Exporter (for Prometheus) ---
MYSQL_EXPORTER_PASSWORD=CHANGE_ME_STRONG_EXPORTER_PASSWORD
