# ===========================================
# AI Accounting System — Development Environment
# ===========================================
# Copy to .env and fill in values.

FLASK_ENV=development
SECRET_KEY=dev-secret-key-not-for-production
JWT_SECRET_KEY=dev-jwt-secret-not-for-production

DATABASE_URL=mysql+pymysql://root:123456@localhost:3306/ai_accounting

REDIS_URL=redis://localhost:6379/0

DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_DEFAULT_MODEL=deepseek-chat

STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_test_your-secret

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

STORAGE_PROVIDER=local

# SMTP Email (optional in dev, required in production)
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@qq.com
# SMTP_PASSWORD=your-authorisation-code
# SMTP_FROM_EMAIL=your-email@qq.com
# SMTP_FROM_NAME=AI 智能记账
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
