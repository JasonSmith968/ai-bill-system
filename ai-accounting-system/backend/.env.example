# =============================================================================
# AI Accounting System - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control!
# =============================================================================

# --- Flask ---
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=change-me-to-a-random-64-char-string

# --- Database ---
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/ai_accounting?charset=utf8mb4
DB_POOL_SIZE=10
DB_POOL_RECYCLE=3600

# --- JWT ---
JWT_SECRET_KEY=change-me-to-a-different-random-64-char-string
JWT_ACCESS_HOURS=24
JWT_REFRESH_DAYS=30

# --- DeepSeek AI (leave empty to use local keyword parser) ---
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Rate Limiting (memory:// for dev, redis://localhost:6379 for prod) ---
RATELIMIT_STORAGE_URI=memory://

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=logs

# --- SMTP Email (optional in dev, required in production) ---
# In development, emails are printed to console if SMTP is not configured.
# In production (FLASK_ENV=production), these are REQUIRED.
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@qq.com
# SMTP_PASSWORD=your-authorisation-code
# SMTP_FROM_EMAIL=your-email@qq.com
# SMTP_FROM_NAME=AI 智能记账
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
